# Copy this file to .env and customise for your environment.
# NEVER commit the .env file to version control.

# Django
# Required when DJANGO_DEBUG=False
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost 127.0.0.1
# Comma-separated browser origins allowed to call the API
DJANGO_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
DJANGO_LOG_LEVEL=INFO
# When DEBUG=False, redirect HTTP→HTTPS (disable behind plain local TLS termination tests)
DJANGO_SECURE_SSL_REDIRECT=True

# Database — leave DATABASE_URL unset to use SQLite (default local dev)
# DATABASE_URL=postgres://user:pass@localhost:5432/nutrilogic
# Or individual vars:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=nutrilogic
# DB_USER=postgres
# DB_PASSWORD=yourpassword
# DB_HOST=localhost
# DB_PORT=5432
